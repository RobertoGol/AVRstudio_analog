# AVR CLI Studio processor profile - AUTOGEN from iom16hvb.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega16HVB
MCU_Target = atmega16hvb
Define_Tag = __AVR_ATmega16HVB__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x0D   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x04FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05

[Interrupts]
1 = BPINT_vect
2 = VREGMON_vect
3 = INT0_vect
4 = INT1_vect
5 = INT2_vect
6 = INT3_vect
7 = PCINT0_vect
8 = PCINT1_vect
9 = WDT_vect
10 = BGSCD_vect
11 = CHDET_vect
12 = TIMER1_IC_vect
13 = TIMER1_COMPA_vect
14 = TIMER1_COMPB_vect
15 = TIMER1_OVF_vect
16 = TIMER0_IC_vect
17 = TIMER0_COMPA_vect
18 = TIMER0_COMPB_vect
