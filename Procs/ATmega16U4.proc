# AVR CLI Studio processor profile - AUTOGEN from iom16u4.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega16U4
MCU_Target = atmega16u4
Define_Tag = __AVR_ATmega16U4__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x88   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x05FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e
  F = 0x0f 0x10 0x11

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = INT2_vect
4 = INT3_vect
7 = INT6_vect
9 = PCINT0_vect
10 = USB_GEN_vect
11 = USB_COM_vect
12 = WDT_vect
16 = TIMER1_CAPT_vect
