# AVR CLI Studio processor profile - AUTOGEN from ioat94k.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = AT94K
MCU_Target = at94k
Define_Tag = __AVR_AT94K__
Default_F_CPU = 1000000

[Memory]
  FlashEnd = 0x7FFF            # последний байт Flash (32 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x0FFF            # вершина стека SP
  EepromEnd = 0x0000

[Ports]
  D = 0x10 0x11 0x12
  E = 0x05 0x06 0x07

[Interrupts]
1 = SIG_FPGA_INTERRUPT0
2 = SIG_INTERRUPT0
3 = SIG_FPGA_INTERRUPT1
4 = SIG_INTERRUPT1
5 = SIG_FPGA_INTERRUPT2
6 = SIG_INTERRUPT2
7 = SIG_FPGA_INTERRUPT3
8 = SIG_INTERRUPT3
9 = SIG_OUTPUT_COMPARE2
10 = SIG_OVERFLOW2
11 = SIG_INPUT_CAPTURE1
12 = SIG_OUTPUT_COMPARE1A
13 = SIG_OUTPUT_COMPARE1B
14 = SIG_OVERFLOW1
15 = SIG_OUTPUT_COMPARE0
16 = SIG_OVERFLOW0
17 = SIG_FPGA_INTERRUPT4
18 = SIG_FPGA_INTERRUPT5
19 = SIG_FPGA_INTERRUPT6
20 = SIG_FPGA_INTERRUPT7
21 = SIG_UART0_RECV
22 = SIG_UART0_DATA
23 = SIG_UART0_TRANS
24 = SIG_FPGA_INTERRUPT8
25 = SIG_FPGA_INTERRUPT9
26 = SIG_FPGA_INTERRUPT10
27 = SIG_FPGA_INTERRUPT11
28 = SIG_UART1_RECV
29 = SIG_UART1_DATA
30 = SIG_UART1_TRANS
31 = SIG_FPGA_INTERRUPT12
32 = SIG_FPGA_INTERRUPT13
33 = SIG_FPGA_INTERRUPT14
34 = SIG_FPGA_INTERRUPT15
35 = SIG_2WIRE_SERIAL

[RegisterMap]
UBRR1|IO8|0x00
UCSR1B|IO8|0x01
UCSR1A|IO8|0x02
UDR1|IO8|0x03
PINE|IO8|0x05
DDRE|IO8|0x06
PORTE|IO8|0x07
OCDR|IO8|0x08
UBRR0|IO8|0x09
UCSR0B|IO8|0x0A
UCSR0A|IO8|0x0B
UDR0|IO8|0x0C
PIND|IO8|0x10
DDRD|IO8|0x11
PORTD|IO8|0x12
FISCR|IO8|0x13
FISUA|IO8|0x14
FISUB|IO8|0x15
FISUC|IO8|0x16
FISUD|IO8|0x17
FPGAX|IO8|0x18
FPGAY|IO8|0x19
FPGAZ|IO8|0x1A
FPGAD|IO8|0x1B
TWBR|IO8|0x1C
TWSR|IO8|0x1D
TWAR|IO8|0x1E
TWDR|IO8|0x1F
UBRRH|IO8|0x20
WDTCR|IO8|0x21
OCR2|IO8|0x22
TCNT2|IO8|0x23
ICR1L|IO8|0x24
ICR1H|IO8|0x25
ASSR|IO8|0x26
TCCR2|IO8|0x27
OCR1BL|IO8|0x28
OCR1BH|IO8|0x29
OCR1AL|IO8|0x2A
OCR1AH|IO8|0x2B
TCNT1L|IO8|0x2C
TCNT1H|IO8|0x2D
TCCR1B|IO8|0x2E
TCCR1A|IO8|0x2F
SFIOR|IO8|0x30
OCR0|IO8|0x31
TCNT0|IO8|0x32
TCCR0|IO8|0x33
MCUR|IO8|0x35
TWCR|IO8|0x36
TIFR|IO8|0x38
TIMSK|IO8|0x39
SFTCR|IO8|0x3A
EIMF|IO8|0x3B

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
