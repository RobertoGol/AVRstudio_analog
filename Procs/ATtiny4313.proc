# AVR CLI Studio processor profile - AUTOGEN from iotn4313.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny4313
MCU_Target = attiny4313
Define_Tag = __AVR_ATtiny4313__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x92 0x0D   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x0FFF            # последний байт Flash (4 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x015F            # вершина стека SP
  EepromEnd = 0x00FF
  SpmPagesize = 64

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  D = 0x10 0x11 0x12

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = TIMER1_CAPT_vect
4 = TIMER1_COMPA_vect
5 = TIMER1_OVF_vect
6 = TIMER0_OVF_vect
7 = USART_RX_vect
8 = USART_UDRE_vect
9 = USART_TX_vect
10 = ANA_COMP_vect
11 = PCINT_B_vect
12 = TIMER1_COMPB_vect
13 = TIMER0_COMPA_vect
14 = TIMER0_COMPB_vect
15 = USI_START_vect
16 = USI_OVERFLOW_vect
17 = EEPROM_Ready_vect
18 = WDT_OVERFLOW_vect
19 = PCINT_A_vect
20 = PCINT_D_vect

[RegisterMap]
DIDR|IO8|0x01
UBRRH|IO8|0x02
UCSRC|IO8|0x03
PCMSK1|IO8|0x04
PCMSK2|IO8|0x05
PRR|IO8|0x06
BODCR|IO8|0x07
ACSR|IO8|0x08
UBRRL|IO8|0x09
UCSRB|IO8|0x0A
UCSRA|IO8|0x0B
UDR|IO8|0x0C
USICR|IO8|0x0D
USISR|IO8|0x0E
USIDR|IO8|0x0F
PIND|IO8|0x10
DDRD|IO8|0x11
PORTD|IO8|0x12
GPIOR0|IO8|0x13
GPIOR1|IO8|0x14
GPIOR2|IO8|0x15
PINB|IO8|0x16
DDRB|IO8|0x17
PORTB|IO8|0x18
PINA|IO8|0x19
DDRA|IO8|0x1A
PORTA|IO8|0x1B
EECR|IO8|0x1C
EEDR|IO8|0x1D
EEAR|IO8|0x1E
PCMSK|IO8|0x20
WDTCR|IO8|0x21
TCCR1C|IO8|0x22
GTCCR|IO8|0x23
ICR1L|IO8|0x24
ICR1H|IO8|0x25
CLKPR|IO8|0x26
OCR1BL|IO8|0x28
OCR1BH|IO8|0x29
OCR1AL|IO8|0x2A
OCR1AH|IO8|0x2B
TCNT1L|IO8|0x2C
TCNT1H|IO8|0x2D
TCCR1B|IO8|0x2E
TCCR1A|IO8|0x2F
TCCR0A|IO8|0x30
OSCCAL|IO8|0x31
TCNT0|IO8|0x32
TCCR0B|IO8|0x33
MCUSR|IO8|0x34
MCUCR|IO8|0x35
OCR0A|IO8|0x36
SPMCSR|IO8|0x37
TIFR|IO8|0x38
TIMSK|IO8|0x39
EIFR|IO8|0x3A
GIMSK|IO8|0x3B
OCR0B|IO8|0x3C

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
