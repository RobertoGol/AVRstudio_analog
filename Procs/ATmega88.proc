# AVR CLI Studio processor profile (README sec.8) - generated from toolchain headers

[Identity]
Name = ATmega88
MCU_Target = atmega88pa
Define_Tag = __AVR_ATmega88PA__
Default_F_CPU = 8000000
InstructSetCore = avr5

[Memory]
SpmPagesize = 64
FlashEnd = 0x1FFF        # last FLASH byte address (bytes: ATmega88)
RegFileStart = 0x0000  # GP registers R0-R31
RegFileEnd = 0x001F
IoStart = 0x0020     # I/O registers in SRAM view (IN/OUT addr = here - 0x20)
ExtIoEnd = 0x00FF    # I/O space end in SRAM view (IN/OUT reachable to 0x5F)
SRAMStart = 0x0100
RamEnd = 0x04FF        # stack top (SP init)
EepromEnd = 0x01FF

[Ports]
# Port token = PIN_IO DDR_IO PORT_IO  (I/O addresses; IN/OUT space)
B = 0x03 0x04 0x05
C = 0x06 0x07 0x08
D = 0x09 0x0A 0x0B

[Interrupts]
Int0Pin = D2
Int1Pin = D3
# vector_index = name ; FLASH address = index*2 (each vector = 1 word RJMP slot)
1 = INT0_vect
2 = INT1_vect
3 = PCINT0_vect
4 = PCINT1_vect
5 = PCINT2_vect
6 = WDT_vect
7 = TIMER2_COMPA_vect
8 = TIMER2_COMPB_vect
9 = TIMER2_OVF_vect
10 = TIMER1_CAPT_vect
11 = TIMER1_COMPA_vect
12 = TIMER1_COMPB_vect
13 = TIMER1_OVF_vect
14 = TIMER0_COMPA_vect
15 = TIMER0_COMPB_vect
16 = TIMER0_OVF_vect
17 = SPI_STC_vect
18 = USART_RX_vect
19 = USART_UDRE_vect
20 = USART_TX_vect
21 = ADC_vect
22 = EE_READY_vect
23 = ANALOG_COMP_vect
24 = TWI_vect
25 = SPM_Ready_vect

[RegisterMap]
# Name|Type|Addr ; Type: IO = IN/OUT space, MEM = mapped SRAM only (extend. I/O)
# SRAM view address = IO + 0x20
SREG|IO8|0x3F
SPL|IO8|0x3D
SPH|IO8|0x3E
PINB|IO8|0x03
DDRB|IO8|0x04
PORTB|IO8|0x05
PINC|IO8|0x06
DDRC|IO8|0x07
PORTC|IO8|0x08
PIND|IO8|0x09
DDRD|IO8|0x0A
PORTD|IO8|0x0B
