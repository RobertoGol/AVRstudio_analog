# AVR CLI Studio processor profile - AUTOGEN from iotn10.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny10
MCU_Target = attiny10
Define_Tag = __AVR_ATtiny10__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x90 0x03   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x03FF            # последний байт Flash (1 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x005F            # вершина стека SP
  EepromEnd = 0x0000
  SpmPagesize = 32

[Ports]
  B = 0x00 0x01 0x02

[Interrupts]
1 = INT0_vect
2 = PCINT0_vect
3 = TIM0_CAPT_vect
4 = TIM0_OVF_vect
5 = TIM0_COMPA_vect
6 = TIM0_COMPB_vect
7 = ANA_COMP_vect
8 = WDT_vect
9 = VLM_vect
10 = ADC_vect

[RegisterMap]
PINB|IO8|0x00
DDRB|IO8|0x01
PORTB|IO8|0x02
PUEB|IO8|0x03
PORTCR|IO8|0x0C
PCMSK|IO8|0x10
PCIFR|IO8|0x11
PCICR|IO8|0x12
EIMSK|IO8|0x13
EIFR|IO8|0x14
EICRA|IO8|0x15
DIDR0|IO8|0x17
ADCL|IO8|0x19
ADMUX|IO8|0x1B
ADCSRB|IO8|0x1C
ADCSRA|IO8|0x1D
ACSR|IO8|0x1F
ICR0L|IO8|0x22
ICR0H|IO8|0x23
OCR0BL|IO8|0x24
OCR0BH|IO8|0x25
OCR0AL|IO8|0x26
OCR0AH|IO8|0x27
TCNT0L|IO8|0x28
TCNT0H|IO8|0x29
TIFR0|IO8|0x2A
TIMSK0|IO8|0x2B
TCCR0C|IO8|0x2C
TCCR0B|IO8|0x2D
TCCR0A|IO8|0x2E
GTCCR|IO8|0x2F
WDTCSR|IO8|0x31
NVMCSR|IO8|0x32
NVMCMD|IO8|0x33
VLMCSR|IO8|0x34
PRR|IO8|0x35
CLKPSR|IO8|0x36
CLKMSR|IO8|0x37
OSCCAL|IO8|0x39
SMCR|IO8|0x3A
RSTFLR|IO8|0x3B
CCP|IO8|0x3C

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
