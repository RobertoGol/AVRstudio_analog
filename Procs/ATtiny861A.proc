# AVR CLI Studio processor profile - AUTOGEN from iotn861a.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny861A
MCU_Target = attiny861a
Define_Tag = __AVR_ATtiny861A__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x93 0x0D   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFF            # последний байт Flash (8 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x025F            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 64

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18

[Interrupts]
1 = INT0_vect
2 = PCINT_vect
3 = TIMER1_COMPA_vect
4 = TIMER1_COMPB_vect
5 = TIMER1_OVF_vect
6 = TIMER0_OVF_vect
7 = USI_START_vect
8 = USI_OVF_vect
9 = EE_RDY_vect
10 = ANA_COMP_vect
11 = ADC_vect
12 = WDT_vect
13 = INT1_vect
14 = TIMER0_COMPA_vect
15 = TIMER0_COMPB_vect
16 = TIMER0_CAPT_vect
17 = TIMER1_COMPD_vect
18 = FAULT_PROTECTION_vect

[RegisterMap]
