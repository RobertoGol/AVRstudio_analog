# AVR CLI Studio processor profile - AUTOGEN from iom161.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega161
MCU_Target = atmega161
Define_Tag = __AVR_ATmega161__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x01   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x045F            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  C = 0x13 0x14 0x15
  D = 0x10 0x11 0x12
  E = 0x05 0x06 0x07

[Interrupts]
1 = SIG_INTERRUPT0
1 = INT0_vect
2 = SIG_INTERRUPT1
2 = INT1_vect
3 = SIG_INTERRUPT2
3 = INT2_vect
4 = SIG_OUTPUT_COMPARE2
4 = TIMER2_COMP_vect
5 = SIG_OVERFLOW2
5 = TIMER2_OVF_vect
6 = SIG_INPUT_CAPTURE1
6 = TIMER1_CAPT_vect
7 = SIG_OUTPUT_COMPARE1A
7 = TIMER1_COMPA_vect
8 = SIG_OUTPUT_COMPARE1B
8 = TIMER1_COMPB_vect
9 = SIG_OVERFLOW1
9 = TIMER1_OVF_vect
10 = SIG_OUTPUT_COMPARE0
10 = TIMER0_COMP_vect
11 = SIG_OVERFLOW0
11 = TIMER0_OVF_vect
12 = SIG_SPI
12 = SPI_STC_vect
13 = SIG_UART0_RECV
13 = UART0_RX_vect
14 = SIG_UART1_RECV
14 = UART1_RX_vect
15 = SIG_UART0_DATA
15 = UART0_UDRE_vect
16 = SIG_UART1_DATA
16 = UART1_UDRE_vect
17 = SIG_UART0_TRANS
17 = UART0_TX_vect
18 = SIG_UART1_TRANS
18 = UART1_TX_vect
19 = SIG_EEPROM_READY
19 = EE_RDY_vect
20 = SIG_COMPARATOR
20 = ANA_COMP_vect

[RegisterMap]
UBRR1|IO8|0x00
UCSR1B|IO8|0x01
UCSR1A|IO8|0x02
UDR1|IO8|0x03
PINE|IO8|0x05
DDRE|IO8|0x06
PORTE|IO8|0x07
ACSR|IO8|0x08
UBRR0|IO8|0x09
UCSR0B|IO8|0x0A
UCSR0A|IO8|0x0B
UDR0|IO8|0x0C
SPCR|IO8|0x0D
SPSR|IO8|0x0E
SPDR|IO8|0x0F
PIND|IO8|0x10
DDRD|IO8|0x11
PORTD|IO8|0x12
PINC|IO8|0x13
DDRC|IO8|0x14
PORTC|IO8|0x15
PINB|IO8|0x16
DDRB|IO8|0x17
PORTB|IO8|0x18
PINA|IO8|0x19
DDRA|IO8|0x1A
PORTA|IO8|0x1B
EECR|IO8|0x1C
EEDR|IO8|0x1D
EEARL|IO8|0x1E
EEARH|IO8|0x1F
UBRRH|IO8|0x20
WDTCR|IO8|0x21
OCR2|IO8|0x22
TCNT2|IO8|0x23
ICR1L|IO8|0x24
ICR1H|IO8|0x25
ASSR|IO8|0x26
