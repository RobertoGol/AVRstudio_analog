# AVR CLI Studio processor profile - AUTOGEN from iom3290.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega3290P
MCU_Target = atmega3290p
Define_Tag = __AVR_ATmega3290P__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x95 0x04   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x7FFF            # последний байт Flash (32 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x08FF            # вершина стека SP
  EepromEnd = 0x03FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e
  F = 0x0f 0x10 0x11
  G = 0x12 0x13 0x14

[Interrupts]
1 = SIG_INTERRUPT0
1 = INT0_vect
2 = SIG_PIN_CHANGE0
2 = PCINT0_vect
3 = SIG_PIN_CHANGE1
3 = PCINT1_vect
4 = SIG_OUTPUT_COMPARE2
4 = TIMER2_COMP_vect
5 = SIG_OVERFLOW2
5 = TIMER2_OVF_vect
6 = SIG_INPUT_CAPTURE1
6 = TIMER1_CAPT_vect
7 = SIG_OUTPUT_COMPARE1A
7 = TIMER1_COMPA_vect
8 = SIG_OUTPUT_COMPARE1B
8 = TIMER1_COMPB_vect
9 = SIG_OVERFLOW1
9 = TIMER1_OVF_vect
10 = SIG_OUTPUT_COMPARE0
10 = TIMER0_COMP_vect
11 = SIG_OVERFLOW0
11 = TIMER0_OVF_vect
12 = SIG_SPI
12 = SPI_STC_vect
13 = SIG_UART_RECV
13 = USART_RX_vect
14 = SIG_UART_DATA
14 = USART_UDRE_vect
15 = SIG_UART_TRANS
15 = USART0_TX_vect
16 = SIG_USI_START
16 = USI_START_vect
17 = SIG_USI_OVERFLOW
17 = USI_OVERFLOW_vect
18 = SIG_COMPARATOR
18 = ANALOG_COMP_vect
19 = SIG_ADC
19 = ADC_vect
20 = SIG_EEPROM_READY
20 = EE_READY_vect
21 = SIG_SPM_READY
21 = SPM_READY_vect
22 = SIG_LCD
22 = LCD_vect
23 = SIG_PIN_CHANGE2
23 = PCINT2_vect
24 = SIG_PIN_CHANGE3
24 = PCINT3_vect

