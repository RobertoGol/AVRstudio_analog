# AVR CLI Studio processor profile - AUTOGEN from iom103.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega103
MCU_Target = atmega103
Define_Tag = __AVR_ATmega103__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x97 0x01   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFFF            # последний байт Flash (128 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x0FFF            # вершина стека SP
  EepromEnd = 0x0FFF

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  D = 0x10 0x11 0x12
  E = 0x01 0x02 0x03

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = INT2_vect
4 = INT3_vect
5 = INT4_vect
6 = INT5_vect
7 = INT6_vect
8 = INT7_vect
9 = TIMER2_COMP_vect
10 = TIMER2_OVF_vect
11 = TIMER1_CAPT_vect
12 = TIMER1_COMPA_vect
13 = TIMER1_COMPB_vect
14 = TIMER1_OVF_vect
15 = TIMER0_COMP_vect
16 = TIMER0_OVF_vect
17 = SPI_STC_vect
18 = UART_RX_vect
19 = UART_UDRE_vect
20 = UART_TX_vect
21 = ADC_vect
22 = EE_READY_vect
23 = ANALOG_COMP_vect

[RegisterMap]
PINF|IO8|0x00
PINE|IO8|0x01
DDRE|IO8|0x02
PORTE|IO8|0x03
ADCL|IO8|0x04
ADCH|IO8|0x05
ADCSR|IO8|0x06
ADMUX|IO8|0x07
ACSR|IO8|0x08
UBRR|IO8|0x09
UCR|IO8|0x0A
USR|IO8|0x0B
UDR|IO8|0x0C
SPCR|IO8|0x0D
SPSR|IO8|0x0E
SPDR|IO8|0x0F
PIND|IO8|0x10
DDRD|IO8|0x11
PORTD|IO8|0x12
PORTC|IO8|0x15
PINB|IO8|0x16
DDRB|IO8|0x17
PORTB|IO8|0x18
PINA|IO8|0x19
DDRA|IO8|0x1A
PORTA|IO8|0x1B
EECR|IO8|0x1C
EEDR|IO8|0x1D
EEARL|IO8|0x1E
EEARH|IO8|0x1F
WDTCR|IO8|0x21
OCR2|IO8|0x23
TCNT2|IO8|0x24
TCCR2|IO8|0x25
ICR1L|IO8|0x26
ICR1H|IO8|0x27
OCR1BL|IO8|0x28
OCR1BH|IO8|0x29
OCR1AL|IO8|0x2A
OCR1AH|IO8|0x2B
TCNT1L|IO8|0x2C
TCNT1H|IO8|0x2D
TCCR1B|IO8|0x2E
TCCR1A|IO8|0x2F
ASSR|IO8|0x30
OCR0|IO8|0x31
TCNT0|IO8|0x32
TCCR0|IO8|0x33
MCUSR|IO8|0x34
MCUCR|IO8|0x35
TIFR|IO8|0x36
TIMSK|IO8|0x37
EIFR|IO8|0x38
EIMSK|IO8|0x39
EICR|IO8|0x3A
RAMPZ|IO8|0x3B
XDIV|IO8|0x3C

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
