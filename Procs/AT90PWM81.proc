# AVR CLI Studio processor profile - AUTOGEN from io90pwm81.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = AT90PWM81
MCU_Target = at90pwm81
Define_Tag = __AVR_AT90PWM81__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x93 0x88   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFF            # последний байт Flash (8 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x01FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 64

[Ports]
  B = 0x03 0x04 0x05
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e

[Interrupts]
1 = PSC2_CAPT_vect
2 = PSC2_EC_vect
3 = PSC2_EEC_vect
4 = PSC0_CAPT_vect
5 = PSC0_EC_vect
