# AVR CLI Studio processor profile - AUTOGEN from iom406.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega406
MCU_Target = atmega406
Define_Tag = __AVR_ATmega406__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x95 0x07   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x9FFF            # последний байт Flash (40 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x08FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05
  D = 0x09 0x0a 0x0b

[Interrupts]
1 = BPINT_vect
2 = INT0_vect
3 = INT1_vect
4 = INT2_vect
5 = INT3_vect
6 = PCINT0_vect
7 = PCINT1_vect
8 = WDT_vect
9 = WAKE_UP_vect
10 = TIM1_COMP_vect
11 = TIM1_OVF_vect
12 = TIM0_COMPA_vect
13 = TIM0_COMPB_vect
14 = TIM0_OVF_vect
15 = TWI_BUS_CD_vect
16 = TWI_vect
17 = VADC_vect
18 = CCADC_CONV_vect
19 = CCADC_REG_CUR_vect
20 = CCADC_ACC_vect
21 = EE_READY_vect
22 = SPM_READY_vect

