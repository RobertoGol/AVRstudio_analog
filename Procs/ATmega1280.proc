# AVR CLI Studio processor profile - AUTOGEN from iom1280.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega1280
MCU_Target = atmega1280
Define_Tag = __AVR_ATmega1280__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x97 0x03   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFFF            # последний байт Flash (128 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x21FF            # вершина стека SP
  EepromEnd = 0x0FFF
  SpmPagesize = 256

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e
  F = 0x0f 0x10 0x11
  G = 0x12 0x13 0x14

