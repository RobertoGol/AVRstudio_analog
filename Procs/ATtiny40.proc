# AVR CLI Studio processor profile - AUTOGEN from iotn40.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny40
MCU_Target = attiny40
Define_Tag = __AVR_ATtiny40__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x92 0x0E   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x0FFF            # последний байт Flash (4 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x013F            # вершина стека SP
  EepromEnd = 0x0000
  SpmPagesize = 64

[Ports]
  A = 0x00 0x01 0x02
  B = 0x04 0x05 0x06
  C = 0x1b 0x1c 0x1d

[Interrupts]
1 = INT0_vect
2 = PCINT0_vect
3 = PCINT1_vect
4 = WDT_vect
5 = TIM1_CAPT_vect
6 = TIM1_COMPA_vect
7 = TIM1_COMPB_vect
8 = TIM1_OVF_vect
9 = TIM0_COMPA_vect
10 = TIM0_COMPB_vect
11 = TIM0_OVF_vect
12 = ANA_COMP_vect
13 = ADC_ADC_vect
14 = TWI_SLAVE_vect
15 = SPI_vect
16 = QTRIP_vect

[RegisterMap]
PINA|IO8|0x00
DDRA|IO8|0x01
PORTA|IO8|0x02
PUEA|IO8|0x03
PINB|IO8|0x04
DDRB|IO8|0x05
PORTB|IO8|0x06
PUEB|IO8|0x07
PORTCR|IO8|0x08
PCMSK0|IO8|0x09
PCMSK1|IO8|0x0A
GIFR|IO8|0x0B
GIMSK|IO8|0x0C
DIDR0|IO8|0x0D
ADCL|IO8|0x0E
ADCH|IO8|0x0F
ADMUX|IO8|0x10
ADCSRB|IO8|0x11
ADCSRA|IO8|0x12
ACSRB|IO8|0x13
ACSRA|IO8|0x14
OCR0B|IO8|0x15
OCR0A|IO8|0x16
TCNT0|IO8|0x17
TCCR0B|IO8|0x18
TCCR0A|IO8|0x19
PCMSK2|IO8|0x1A
PINC|IO8|0x1B
DDRC|IO8|0x1C
PORTC|IO8|0x1D
PUEC|IO8|0x1E
RAMDR|IO8|0x1F
RAMAR|IO8|0x20
OCR1B|IO8|0x21
OCR1A|IO8|0x22
TCNT1L|IO8|0x23
TCCR1A|IO8|0x24
TIFR|IO8|0x25
TIMSK|IO8|0x26
TCNT1H|IO8|0x27
TWSD|IO8|0x28
TWSAM|IO8|0x29
TWSA|IO8|0x2A
TWSSRA|IO8|0x2B
TWSCRB|IO8|0x2C
TWSCRA|IO8|0x2D
SPDR|IO8|0x2E
SPSR|IO8|0x2F
SPCR|IO8|0x30
WDTCSR|IO8|0x31
NVMCSR|IO8|0x32
NVMCMD|IO8|0x33
QTCSR|IO8|0x34
PRR|IO8|0x35
CLKPSR|IO8|0x36
CLKMSR|IO8|0x37
DWDR|IO8|0x38
OSCCAL|IO8|0x39
MCUCR|IO8|0x3A
RSTFLR|IO8|0x3B
CCP|IO8|0x3C

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
