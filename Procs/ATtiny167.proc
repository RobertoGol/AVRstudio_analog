# AVR CLI Studio processor profile - AUTOGEN from iotn167.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny167
MCU_Target = attiny167
Define_Tag = __AVR_ATtiny167__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x87   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x02FE            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = PCINT0_vect
4 = PCINT1_vect
5 = WDT_vect
6 = TIMER1_CAPT_vect
7 = TIMER1_COMPA_vect
8 = TIMER1_COMPB_vect
9 = TIMER1_OVF_vect
10 = TIMER0_COMPA_vect
11 = TIMER0_OVF_vect
12 = LIN_TC_vect
13 = LIN_ERR_vect
14 = SPI_STC_vect
15 = ADC_vect
16 = EE_RDY_vect
17 = ANA_COMP_vect
18 = USI_START_vect
19 = USI_OVF_vect

