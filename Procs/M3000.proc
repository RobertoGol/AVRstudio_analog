# AVR CLI Studio processor profile - AUTOGEN from iom3000.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = M3000
MCU_Target = m3000
Define_Tag = __AVR_M3000__
Default_F_CPU = 1000000

[Memory]
  FlashEnd = 0xFFFF            # последний байт Flash (64 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x0FFF            # вершина стека SP
  EepromEnd = 0x0000

[Ports]
# порты вне I/O-пространства (расширенные или отсутствуют)

[RegisterMap]
IPDL|IO8|0x00
IPDH|IO8|0x01
IPAL|IO8|0x02
IPAH|IO8|0x03
IPCR|IO8|0x04
ADRSLTL|IO8|0x05
