# AVR CLI Studio processor profile (README sec.8) - generated from toolchain headers

[Identity]
Name = ATtiny2313
MCU_Target = attiny2313a
Define_Tag = __AVR_ATtiny2313A__
Default_F_CPU = 1000000
InstructSetCore = avr2

[Memory]
FlashEnd = 0x07FF        # last FLASH byte address (bytes: ATtiny2313)
RegFileStart = 0x0000  # GP registers R0-R31
RegFileEnd = 0x001F
IoStart = 0x0020     # I/O registers in SRAM view (IN/OUT addr = here - 0x20)
ExtIoEnd = 0x005F    # I/O space end in SRAM view (IN/OUT reachable to 0x5F)
SRAMStart = 0x0060
RamEnd = 0x00DF        # stack top (SP init)
EepromEnd = 0x007F

[Ports]
# Port token = PIN_IO DDR_IO PORT_IO  (I/O addresses; IN/OUT space)
A = 0x19 0x1A 0x1B
B = 0x16 0x17 0x18
D = 0x10 0x11 0x12

[Interrupts]
# vector_index = name ; FLASH address = index*2 (each vector = 1 word RJMP slot)
1 = INT0_vect
2 = INT1_vect
3 = TIMER1_CAPT_vect
4 = TIMER1_COMPA_vect
5 = TIMER1_OVF_vect
6 = TIMER0_OVF_vect
7 = USART_RX_vect
8 = USART_UDRE_vect
9 = USART_TX_vect
10 = ANA_COMP_vect
11 = PCINT_B_vect
12 = TIMER1_COMPB_vect
13 = TIMER0_COMPA_vect
14 = TIMER0_COMPB_vect
15 = USI_START_vect
16 = USI_OVERFLOW_vect
17 = EEPROM_Ready_vect
18 = WDT_OVERFLOW_vect
19 = PCINT_A_vect
20 = PCINT_D_vect

[RegisterMap]
# Name|Type|Addr ; Type: IO = IN/OUT space, MEM = mapped SRAM only (extend. I/O)
# SRAM view address = IO + 0x20
SREG|IO8|0x3F
SPL|IO8|0x3D
SPH|IO8|0x3E
DIDR|IO8|0x001
UBRRH|IO8|0x002
UCSRC|IO8|0x003
PCMSK1|IO8|0x004
PCMSK2|IO8|0x005
PRR|IO8|0x006
BODCR|IO8|0x007
ACSR|IO8|0x008
UBRRL|IO8|0x009
UCSRB|IO8|0x00A
UCSRA|IO8|0x00B
UDR|IO8|0x00C
USICR|IO8|0x00D
USISR|IO8|0x00E
USIDR|IO8|0x00F
PIND|IO8|0x010
DDRD|IO8|0x011
PORTD|IO8|0x012
GPIOR0|IO8|0x013
GPIOR1|IO8|0x014
GPIOR2|IO8|0x015
PINB|IO8|0x016
DDRB|IO8|0x017
PORTB|IO8|0x018
PINA|IO8|0x019
DDRA|IO8|0x01A
PORTA|IO8|0x01B
EECR|IO8|0x01C
EEDR|IO8|0x01D
EEAR|IO8|0x01E
PCMSK|IO8|0x020
WDTCR|IO8|0x021
TCCR1C|IO8|0x022
GTCCR|IO8|0x023
ICR1L|IO8|0x024
ICR1H|IO8|0x025
CLKPR|IO8|0x026
OCR1BL|IO8|0x028
OCR1BH|IO8|0x029
OCR1AL|IO8|0x02A
OCR1AH|IO8|0x02B
TCNT1L|IO8|0x02C
TCNT1H|IO8|0x02D
TCCR1B|IO8|0x02E
TCCR1A|IO8|0x02F
TCCR0A|IO8|0x030
OSCCAL|IO8|0x031
TCNT0|IO8|0x032
TCCR0B|IO8|0x033
MCUSR|IO8|0x034
MCUCR|IO8|0x035
OCR0A|IO8|0x036
SPMCSR|IO8|0x037
TIFR|IO8|0x038
