# AVR CLI Studio processor profile - AUTOGEN from io90pwm2b.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = AT90PWM2B
MCU_Target = at90pwm2b
Define_Tag = __AVR_AT90PWM2B__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x93 0x83   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFF            # последний байт Flash (8 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x02FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 64

[Ports]
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e

