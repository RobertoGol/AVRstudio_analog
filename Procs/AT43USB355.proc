# AVR CLI Studio processor profile - AUTOGEN from io43u35x.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = AT43USB355
MCU_Target = at43usb355
Define_Tag = __AVR_AT43USB355__
Default_F_CPU = 1000000

[Signature]
Signature = 0x00 0x00 0x00   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x5FFF            # последний байт Flash (24 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x045F            # вершина стека SP
  EepromEnd = 0x0000

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  C = 0x13 0x14 0x15
  D = 0x10 0x11 0x12
  E = 0x01 0x02 0x03
  F = 0x04 0x05 0x06

[Interrupts]
1 = SIG_INTERRUPT0
2 = SIG_INTERRUPT1
3 = SIG_INPUT_CAPTURE1
3 = SIG_TIMER1_CAPT1
4 = SIG_OUTPUT_COMPARE1A
5 = SIG_OUTPUT_COMPARE1B
6 = SIG_OVERFLOW1
7 = SIG_OVERFLOW0
8 = SIG_SPI
11 = SIG_ADC
12 = SIG_USB_INT

[RegisterMap]
PINE|IO8|0x01
ADCL|IO8|0x02
DDRE|IO8|0x02
ADCH|IO8|0x03
PORTE|IO8|0x03
PINF|IO8|0x04
DDRF|IO8|0x05
PORTF|IO8|0x06
ADCSR|IO8|0x07
ACSR|IO8|0x08
ADMUX|IO8|0x08
SPCR|IO8|0x0D
SPSR|IO8|0x0E
SPDR|IO8|0x0F
PIND|IO8|0x10
DDRD|IO8|0x11
PORTD|IO8|0x12
PINC|IO8|0x13
DDRC|IO8|0x14
PORTC|IO8|0x15
PINB|IO8|0x16
DDRB|IO8|0x17
PORTB|IO8|0x18
PINA|IO8|0x19
DDRA|IO8|0x1A
PORTA|IO8|0x1B
WDTCR|IO8|0x21
ICR1L|IO8|0x24
ICR1H|IO8|0x25
OCR1BL|IO8|0x28
OCR1BH|IO8|0x29
OCR1AL|IO8|0x2A
OCR1AH|IO8|0x2B
TCNT1L|IO8|0x2C
TCNT1H|IO8|0x2D
TCCR1B|IO8|0x2E
TCCR1A|IO8|0x2F
TCNT0|IO8|0x32
TCCR0|IO8|0x33
MCUCR|IO8|0x35
TIFR|IO8|0x38
TIMSK|IO8|0x39
GIFR|IO8|0x3A
GIMSK|IO8|0x3B

[Cycles]
# Instruction clocks (avr4 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
