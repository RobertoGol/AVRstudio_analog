# AVR CLI Studio processor profile - AUTOGEN from iox32x1.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATxmega32X1
MCU_Target = atxmega32x1
Define_Tag = __AVR_ATxmega32X1__
Default_F_CPU = 1000000

[Memory]
  FlashEnd = 0x8FFF            # последний байт Flash (36 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x27FF            # вершина стека SP

[Ports]
# порты вне I/O-пространства (расширенные или отсутствуют)

[Interrupts]
1 = FET_PROT_vect
2 = VREF_VREF_vect
3 = LDO_LDO_WARN_vect
4 = PORTA_INT0_vect
5 = PORTA_INT1_vect
6 = PORTC_INT0_vect
7 = PORTC_INT1_vect
8 = TIMER_OVF_vect
9 = TIMER_OCFA_vect
10 = TIMER_OCFB_vect
11 = TIMER_ICF_vect
12 = BCD_BCD_vect
13 = USARTC_RXC_vect
14 = USARTC_DRE_vect
15 = USARTC_TXC_vect
16 = TWIC_TWIS_vect
19 = VADC_VADCCF_vect
20 = VADC_VADCPROTF_vect
21 = CADC_CADCCF_vect
22 = CADC_CADCSM_vect
23 = NVM_SPM_vect

