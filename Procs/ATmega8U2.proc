# AVR CLI Studio processor profile - AUTOGEN from iom8u2.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega8U2
MCU_Target = atmega8u2
Define_Tag = __AVR_ATmega8U2__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x93 0x89   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFF            # последний байт Flash (8 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x02FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = INT2_vect
4 = INT3_vect
5 = INT4_vect
6 = INT5_vect
7 = INT6_vect
8 = INT7_vect
9 = PCINT0_vect
10 = PCINT1_vect
11 = USB_GEN_vect
12 = USB_COM_vect
13 = WDT_vect
14 = TIMER1_CAPT_vect
15 = TIMER1_COMPA_vect
16 = TIMER1_COMPB_vect
17 = TIMER1_COMPC_vect
18 = TIMER1_OVF_vect
19 = TIMER0_COMPA_vect
20 = TIMER0_COMPB_vect
21 = TIMER0_OVF_vect
22 = SPI_STC_vect
23 = USART1_RX_vect
24 = USART1_UDRE_vect
25 = USART1_TX_vect
26 = ANALOG_COMP_vect
27 = EE_READY_vect
28 = SPM_READY_vect

