# AVR CLI Studio processor profile - AUTOGEN from iom64hve.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega64HVE
MCU_Target = atmega64hve
Define_Tag = __AVR_ATmega64HVE__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x96 0x10   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0xFFFF            # последний байт Flash (64 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x10FF            # вершина стека SP
  EepromEnd = 0x03FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05

[Interrupts]
1 = INT0_vect
2 = PCINT0_vect
3 = PCINT1_vect
4 = WDT_vect
5 = WAKEUP_vect
6 = TIMER1_IC_vect
7 = TIMER1_COMPA_vect
8 = TIMER1_COMPB_vect
9 = TIMER1_OVF_vect
10 = TIMER0_IC_vect
11 = TIMER0_COMPA_vect
12 = TIMER0_COMPB_vect
13 = TIMER0_OVF_vect
14 = LIN_STATUS_vect
15 = LIN_ERROR_vect
16 = SPI_STC_vect
17 = VADC_CONV_vect
18 = VADC_ACC_vect
19 = CADC_CONV_vect
20 = CADC_REG_CUR_vect
21 = CADC_ACC_vect
22 = EE_READY_vect
23 = SPM_vect
24 = PLL_vect

