# AVR CLI Studio processor profile - AUTOGEN from ioa6289.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATA6289
MCU_Target = ata6289
Define_Tag = __AVR_ATA6289__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x93 0x82   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x2000            # последний байт Flash (9 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x02FF            # вершина стека SP
  EepromEnd = 0x0140
  SpmPagesize = 64

[Ports]
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = PCINT0_vect
4 = PCINT1_vect
5 = PCINT2_vect
6 = INTVM_vect
7 = SENINT_vect
8 = INTT0_vect
9 = LFWP_vect
10 = T3CAP_vect
11 = T3COMA_vect
12 = T3COMB_vect
13 = T3OVF_vect
14 = T2CAP_vect
15 = T2COM_vect
16 = T2OVF_vect
17 = SPISTC_vect
18 = LFRXB_vect
19 = INTT1_vect
20 = T2RXB_vect
21 = T2TXB_vect
22 = T2TXC_vect
23 = LFREOB_vect
24 = EXCM_vect
25 = EEREADY_vect
26 = SPM_RDY_vect

