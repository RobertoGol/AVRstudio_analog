# AVR CLI Studio processor profile - AUTOGEN from iom324pa.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega324PA
MCU_Target = atmega324pa
Define_Tag = __AVR_ATmega324PA__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x95 0x11   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x7FFF            # последний байт Flash (32 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x08FF            # вершина стека SP
  EepromEnd = 0x03FF
  SpmPagesize = 128

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = INT2_vect
4 = PCINT0_vect
5 = PCINT1_vect
6 = PCINT2_vect
7 = PCINT3_vect
8 = WDT_vect
9 = TIMER2_COMPA_vect
10 = TIMER2_COMPB_vect
11 = TIMER2_OVF_vect
12 = TIMER1_CAPT_vect
13 = TIMER1_COMPA_vect
14 = TIMER1_COMPB_vect
15 = TIMER1_OVF_vect
