# AVR CLI Studio processor profile - AUTOGEN from iotn48.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny48
MCU_Target = attiny48
Define_Tag = __AVR_ATtiny48__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x92 0x09   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x0FFF            # последний байт Flash (4 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x01FF            # вершина стека SP
  EepromEnd = 0x003F
  SpmPagesize = 32

[Ports]
  A = 0x0c 0x0d 0x0e
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b

[Interrupts]
1 = INT0_vect
2 = INT1_vect
3 = PCINT0_vect
4 = PCINT1_vect
5 = PCINT2_vect
6 = PCINT3_vect
7 = WDT_vect
8 = TIMER1_CAPT_vect
9 = TIMER1_COMPA_vect
10 = TIMER1_COMPB_vect
11 = TIMER1_OVF_vect
12 = TIMER0_COMPA_vect
13 = TIMER0_COMPB_vect
14 = TIMER0_OVF_vect
15 = SPI_STC_vect
16 = ADC_vect
17 = EE_READY_vect
18 = ANALOG_COMP_vect
19 = TWI_vect

[RegisterMap]
PINB|IO8|0x03
DDRB|IO8|0x04
PORTB|IO8|0x05
PINC|IO8|0x06
DDRC|IO8|0x07
PORTC|IO8|0x08
PIND|IO8|0x09
DDRD|IO8|0x0A
PORTD|IO8|0x0B
