TCNT0|IO8|0x26
OCR0A|IO8|0x27
OCR0B|IO8|0x28
GPIOR1|IO8|0x2A
GPIOR2|IO8|0x2B
SPCR|IO8|0x2C
SPSR|IO8|0x2D
SPDR|IO8|0x2E
ACSR|IO8|0x30
SMCR|IO8|0x33
MCUSR|IO8|0x34
MCUCR|IO8|0x35
SPMCSR|IO8|0x37
WDTCSR|MEM8|0x60
CLKPR|MEM8|0x61
PRR|MEM8|0x64
OSCCAL|MEM8|0x66
PCICR|MEM8|0x68
EICRA|MEM8|0x69
PCMSK3|MEM8|0x6A
PCMSK0|MEM8|0x6B
PCMSK1|MEM8|0x6C
PCMSK2|MEM8|0x6D
TIMSK0|MEM8|0x6E
TIMSK1|MEM8|0x6F
ADCL|MEM8|0x78
ADCH|MEM8|0x79
ADCSRA|MEM8|0x7A
ADCSRB|MEM8|0x7B
ADMUX|MEM8|0x7C
DIDR0|MEM8|0x7E
DIDR1|MEM8|0x7F
TCCR1A|MEM8|0x80
TCCR1B|MEM8|0x81
TCCR1C|MEM8|0x82
TCNT1L|MEM8|0x84
TCNT1H|MEM8|0x85
ICR1L|MEM8|0x86
