# AVR CLI Studio processor profile (README sec.8) - generated from toolchain headers

[Identity]
Name = ATtiny13
MCU_Target = attiny13
Define_Tag = __AVR_ATtiny13__
Default_F_CPU = 1200000
InstructSetCore = avr2

[Memory]
SpmPagesize = 32
FlashEnd = 0x03FF        # last FLASH byte address (bytes: ATtiny13)
RegFileStart = 0x0000  # GP registers R0-R31
RegFileEnd = 0x001F
IoStart = 0x0020     # I/O registers in SRAM view (IN/OUT addr = here - 0x20)
ExtIoEnd = 0x005F    # I/O space end in SRAM view (IN/OUT reachable to 0x5F)
SRAMStart = 0x0060
RamEnd = 0x009F        # stack top (SP init)
EepromEnd = 0x003F

[Ports]
# Port token = PIN_IO DDR_IO PORT_IO  (I/O addresses; IN/OUT space)
B = 0x16 0x17 0x18

[Interrupts]
Int0Pin = B1
# vector_index = name ; FLASH address = index*2 (each vector = 1 word RJMP slot)
1 = INT0_vect
2 = PCINT0_vect
3 = TIM0_OVF_vect
4 = EE_RDY_vect
5 = ANA_COMP_vect
6 = TIM0_COMPA_vect
7 = TIM0_COMPB_vect
8 = WDT_vect
9 = ADC_vect

[RegisterMap]
# Name|Type|Addr ; Type: IO = IN/OUT space, MEM = mapped SRAM only (extend. I/O)
# SRAM view address = IO + 0x20
SREG|IO8|0x3F
SPL|IO8|0x3D
SPH|IO8|0x3E
ADCSRB|IO8|0x03
ADCL|IO8|0x04
ADCH|IO8|0x05
ADCSRA|IO8|0x06
ADMUX|IO8|0x07
ACSR|IO8|0x08
DIDR0|IO8|0x14
PCMSK|IO8|0x15
PINB|IO8|0x16
DDRB|IO8|0x17
PORTB|IO8|0x18
EECR|IO8|0x1C
EEDR|IO8|0x1D
EEARL|IO8|0x1E
EEAR|IO8|0x1E
WDTCR|IO8|0x21
PRR|IO8|0x25
CLKPR|IO8|0x26
GTCCR|IO8|0x28
OCR0B|IO8|0x29
DWDR|IO8|0x2E
TCCR0A|IO8|0x2F
BODCR|IO8|0x30
OSCCAL|IO8|0x31
TCNT0|IO8|0x32
TCCR0B|IO8|0x33
MCUSR|IO8|0x34
MCUCR|IO8|0x35
OCR0A|IO8|0x36
SPMCSR|IO8|0x37
TIFR0|IO8|0x38
TIMSK0|IO8|0x39
GIFR|IO8|0x3A
GIMSK|IO8|0x3B

[Cycles]
# Instruction clocks (avr2 core)
LDI/MOV/MOVW/ADD/SUB/AND/OR/EOR/INC/DEC/COM/NEG/SWAP/SER/BST/BLD/BSET/BCLR = 1
LSL/LSR/ROL/ROR/ASR = 1
MUL/MULS/MULSU/FMUL = 2
ADIW/SBIW/LDS/STS/LD/ST/LPM/IN/OUT/PUSH/POP/SBI/CBI/SBRC/SBRS/SBIC/SBIS/SEC (SE/CL aliases)/CP/SUBI variants = 1-2
RJMP/RCALL (not taken) branch/IJMP/ICALL/JMP = 2
Branch taken = 2 ; not taken = 1
RCALL = 3 ; RET/RETI/JMP/CALL = 4
StopWatch: Time_us = Cycles * 1000000 / F_CPU

[GPIO rules]
# DDRx=1 -> output: PIN reads PORT latch (or stimulus level if external)
# DDRx=0 & PORTx=1 -> input with pull-up: PIN reads 1 unless external stimulus is 0
# DDRx=0 & PORTx=0 -> Hi-Z: floating, PIN reads external stimulus
# Writing 1 to PINx bit (with DDRx=1) toggles PORTx latch
