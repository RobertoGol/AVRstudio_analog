# AVR CLI Studio processor profile - AUTOGEN from iotn1634.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATtiny1634
MCU_Target = attiny1634
Define_Tag = __AVR_ATtiny1634__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x12   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x04FF            # вершина стека SP
  EepromEnd = 0x00FF
  SpmPagesize = 32

[Ports]
  A = 0x0f 0x10 0x11
  B = 0x0b 0x0c 0x0d
  C = 0x07 0x08 0x09

[Interrupts]
1 = INT0_vect
2 = PCINT0_vect
3 = PCINT1_vect
4 = PCINT2_vect
5 = WDT_vect
6 = TIMER1_CAPT_vect
7 = TIMER1_COMPA_vect
8 = TIMER1_COMPB_vect
9 = TIMER1_OVF_vect
10 = TIMER0_COMPA_vect
11 = TIMER0_COMPB_vect
12 = TIMER0_OVF_vect
13 = ANA_COMP_vect
14 = ADC_vect
15 = USART0_START_vect
16 = USART0_RX_vect
17 = USART0_UDRE_vect
18 = USART0_TX_vect
19 = USART1_START_vect
20 = USART1_RX_vect
21 = USART1_UDRE_vect
22 = USART1_TX_vect
23 = USI_START_vect
24 = USI_OVERFLOW_vect
25 = TWI_SLAVE_vect
26 = EE_RDY_vect
27 = QTRIP_vect

