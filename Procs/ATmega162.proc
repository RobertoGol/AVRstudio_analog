# AVR CLI Studio processor profile - AUTOGEN from iom162.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega162
MCU_Target = atmega162
Define_Tag = __AVR_ATmega162__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x04   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x04FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  C = 0x13 0x14 0x15
  D = 0x10 0x11 0x12
  E = 0x05 0x06 0x07

[Interrupts]
1 = SIG_INTERRUPT0
1 = INT0_vect
2 = SIG_INTERRUPT1
2 = INT1_vect
3 = SIG_INTERRUPT2
3 = INT2_vect
4 = SIG_PIN_CHANGE0
4 = PCINT0_vect
5 = SIG_PIN_CHANGE1
5 = PCINT1_vect
6 = SIG_INPUT_CAPTURE3
