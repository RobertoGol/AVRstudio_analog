# AVR CLI Studio processor profile - AUTOGEN from iocan64.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = AT90CAN64
MCU_Target = at90can64
Define_Tag = __AVR_AT90CAN64__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x96 0x81   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0xFFFF            # последний байт Flash (64 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x10FF            # вершина стека SP
  EepromEnd = 0x07FF
  SpmPagesize = 256

[Ports]
  A = 0x00 0x01 0x02
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e
  F = 0x0f 0x10 0x11
  G = 0x12 0x13 0x14

