# AVR CLI Studio processor profile - AUTOGEN from iom16m1.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega16M1
MCU_Target = atmega16m1
Define_Tag = __AVR_ATmega16M1__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x94 0x84   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x3FFF            # последний байт Flash (16 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x04FF            # вершина стека SP
  EepromEnd = 0x01FF
  SpmPagesize = 128

[Ports]
  B = 0x03 0x04 0x05
  C = 0x06 0x07 0x08
  D = 0x09 0x0a 0x0b
  E = 0x0c 0x0d 0x0e

[Interrupts]
1 = ANACOMP0_vect
2 = ANACOMP1_vect
3 = ANACOMP2_vect
4 = ANACOMP3_vect
5 = PSC_FAULT_vect
6 = PSC_EC_vect
7 = INT0_vect
8 = INT1_vect
9 = INT2_vect
10 = INT3_vect
11 = TIMER1_CAPT_vect
12 = TIMER1_COMPA_vect
13 = TIMER1_COMPB_vect
14 = TIMER1_OVF_vect
15 = TIMER0_COMPA_vect
16 = TIMER0_COMPB_vect
17 = TIMER0_OVF_vect
18 = CAN_INT_vect
19 = CAN_TOVF_vect
20 = LIN_TC_vect
21 = LIN_ERR_vect
22 = PCINT0_vect
23 = PCINT1_vect
24 = PCINT2_vect
25 = PCINT3_vect
26 = SPI_STC_vect
27 = ADC_vect
28 = WDT_vect
29 = EE_READY_vect
30 = SPM_READY_vect

