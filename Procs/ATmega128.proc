# AVR CLI Studio processor profile - AUTOGEN from iom128.h (tools/genprocs.ps1)
# Источник: заголовок тулчейна avr-gcc. Ручные правки потеряются при -Overwrite.

[Identity]
Name = ATmega128
MCU_Target = atmega128
Define_Tag = __AVR_ATmega128__
Default_F_CPU = 1000000

[Signature]
Signature = 0x1E 0x97 0x02   # device id (SPM BLBSET / avrdude)

[Memory]
  FlashEnd = 0x1FFFF            # последний байт Flash (128 КБ)
  SRAMStart = 0x0060            # начало ОЗУ данных
  RamEnd = 0x10FF            # вершина стека SP
  EepromEnd = 0x0FFF
  SpmPagesize = 256

[Ports]
  A = 0x19 0x1a 0x1b
  B = 0x16 0x17 0x18
  C = 0x13 0x14 0x15
  D = 0x10 0x11 0x12
  E = 0x01 0x02 0x03

